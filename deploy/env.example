# Copy to `.env` next to docker-compose.yml, fill in, chmod 600. Read by docker compose (docker-compose.yml).
# Never commit it. Make the passwords with: openssl rand -hex 24

# MongoDB: root (set once, when mongo-prod/data is still empty; changing it later does nothing to MongoDB)
MONGO_ROOT_PASSWORD=
# the app's login (user `testpulse`, made by hand: README step 3), also in MONGODB_URI of .env.prod / backup.env
TESTPULSE_DB_PASSWORD=

# MinIO on this machine (the app's files + this side's backups)
MINIO_ROOT_USER=testpulse-admin
MINIO_ROOT_PASSWORD=

# mongod --wiredTigerCacheSizeGB: 2 on an 8 GB machine (1 on 4 GB)
MONGO_CACHE_GB=2
# the MinIO web console, on 127.0.0.1 only (ssh -L 9000:127.0.0.1:9000 <server>)
MINIO_CONSOLE_PORT=9000
