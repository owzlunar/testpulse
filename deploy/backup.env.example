# Settings for scripts/backup.sh, restore.sh and verify.sh on the prod server. Copy to `backup.env`
# (next to docker-compose.yml), fill in the <...>, chmod 600. Never commit it.
# The tools run in containers on the network `testpulse`, so MongoDB / MinIO are reached by service name.
# (The backup agent in the app container runs them installed there instead: it sets that itself.)
BACKUP_DOCKER_NETWORK=testpulse

# --- The backup agent (BACKUP_AGENT=embedded in .env.prod): the API's BACKUP_AGENT_TOKEN, the same value
# in both files; the secret encrypts the alert URLs it keeps. Both: openssl rand -hex 32
BACKUP_AGENT_TOKEN=<the same as BACKUP_AGENT_TOKEN in backend/.env.prod>
BACKUP_AGENT_SECRET=<openssl rand -hex 32>
# a disk fuller than this (percent) raises an alert
AGENT_DISK_LIMIT_PERCENT=80

# --- MongoDB: the same as MONGODB_URI in backend/.env.prod
MONGODB_URI=mongodb://testpulse:<TESTPULSE_DB_PASSWORD>@mongodb-prod:27017/testpulse?authSource=admin&replicaSet=rs0&directConnection=true
RESTORE_MONGODB_URI=

# --- This side: the MinIO on this machine (S3 API port 9001 inside the network)
BACKUP_S3_URL=http://minio-prod:9001
BACKUP_S3_ACCESS_KEY=<MINIO_ROOT_USER>
BACKUP_S3_SECRET_KEY=<MINIO_ROOT_PASSWORD>
BACKUP_BUCKET=testpulse-backups

# --- Off-site: the mirror machine (mirror/), over https
OFFSITE_S3_URL=https://<backup host, e.g. backup.example.com>
OFFSITE_S3_ACCESS_KEY=<the mirror's MINIO_ROOT_USER>
OFFSITE_S3_SECRET_KEY=<the mirror's MINIO_ROOT_PASSWORD>

# --- Uploaded files: the same as .env.prod (STORAGE_DRIVER=minio, MINIO_BUCKET from backend/.env)
STORAGE_DRIVER=minio
UPLOADS_DIR=./docker-data/uploads
UPLOADS_BUCKET=testpulse

BACKUP_RETENTION_DAYS=14
BACKUP_WORK_DIR=./docker-data/backup-work

MONGO_TOOLS_IMAGE=mongo:8
MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
