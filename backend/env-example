# Template of the per-environment settings file: .env.dev (development) or .env.prod (container).
# Create one with fresh secrets: npm run env:init -- dev   (or: prod)
# Shared defaults live in .env (in git); anything here overrides them. These files stay out of git.

# public URL of the web app (with the sub path when a reverse proxy serves it under one,
# e.g. https://mydomain/testpulse): invite links, CORS origin, cookie and file paths
BASE_URL=http://localhost:3000
# development only: the API's port (the container fixes its own)
PORT=4000
# refresh cookie over HTTPS only (true behind https)
COOKIE_SECURE=false

# MongoDB 6+ replica set (it carries the login: keep this file private)
MONGODB_URI=mongodb://user:pass@localhost:27017/testpulse-dev?authSource=admin&replicaSet=rs0&directConnection=true

# secrets (generated by env:init). Keep them: data is encrypted with ENCRYPTION_KEY_* / BLIND_INDEX_SALT,
# changing them makes stored data unreadable. Rotation: add ENCRYPTION_KEY_V2, set
# ENCRYPTION_CURRENT_KEY_ID=v2 (here), run `npm run keys:rotate`.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ENCRYPTION_KEY_V1=
BLIND_INDEX_SALT=

# files: local (STORAGE_LOCAL_ROOT) or minio
STORAGE_DRIVER=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# mail: log (print to the console, development) or smtp (required in production)
MAIL_DRIVER=log
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# AI test case drafts from a local Ollama (leave AI_PROVIDER=none until the server is ready)
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:14b

# first start on an empty database: the first Admin (remove the password after the first sign-in)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
