# TestPulse API. Copy to .env with `npm run env:init` (it fills the secrets below with fresh random values).
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
BASE_PATH=/api/v1
# the web app: invite links point here, and it is the allowed CORS origin
APP_URL=http://localhost:5173
# more allowed browser origins, comma-separated
CORS_ORIGINS=
TRUST_PROXY=1
BODY_LIMIT=1mb
# requests per user/IP per 15 min (whole API) · sign-in / register / refresh / invite per IP per minute
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_AUTH=20

# MongoDB 6+ replica set (transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/testpulse?replicaSet=rs0
MAX_PAGE_SIZE=100
# 0 = keep audit entries forever
AUDIT_RETENTION_DAYS=0
CRON_TIMEZONE=Asia/Bangkok

# Access tokens (RS256). PEM with \n for line breaks. Generated by `npm run env:init`.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=testpulse
JWT_AUDIENCE=testpulse-web
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=14
INVITE_TTL_HOURS=72
# refresh cookie over HTTPS only (defaults to true in production)
COOKIE_SECURE=false

# Field encryption key ring (64 hex chars each) and blind index salt. Generated by `npm run env:init`.
# Rotation: add ENCRYPTION_KEY_V2, set ENCRYPTION_CURRENT_KEY_ID=v2, run `npm run keys:rotate`.
ENCRYPTION_CURRENT_KEY_ID=v1
ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BLIND_INDEX_SALT=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Files: local | minio
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=testpulse
UPLOAD_MAX_BYTES=2097152

# Mail: log (print to the console, development) | smtp
MAIL_DRIVER=log
MAIL_FROM=TestPulse <no-reply@testpulse.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
