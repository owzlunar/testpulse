# Shared defaults for every environment: in git, so NO secrets or passwords here.
# .env.dev (development) / .env.prod (container) override these; variables set in the real
# environment (shell, docker-compose `environment`) override both. Tests don't read this file.
LOG_LEVEL=info
BASE_PATH=/api/v1
CORS_ORIGINS=
TRUST_PROXY=1
BODY_LIMIT=1mb
RATE_LIMIT_GLOBAL=1000
RATE_LIMIT_AUTH=20

# default database: local MongoDB without a login (the URI is in git, so never put credentials
# here; .env.dev / .env.prod set the real one with its user and password)
MONGODB_URI=mongodb://localhost:27017/testpulse?authSource=admin&replicaSet=rs0&directConnection=true
MAX_PAGE_SIZE=100
# 0 = keep audit entries forever
AUDIT_RETENTION_DAYS=0
NOTIFICATION_RETENTION_DAYS=90
CRON_TIMEZONE=Asia/Bangkok

JWT_ISSUER=testpulse
JWT_AUDIENCE=testpulse-web
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7
# a just-rotated refresh token still works this long (aborted requests, two tabs at once)
REFRESH_REUSE_GRACE_SEC=30
INVITE_TTL_HOURS=72
# the key (ENCRYPTION_KEY_<ID>) new values are encrypted with; the keys themselves are per environment
ENCRYPTION_CURRENT_KEY_ID=v1

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/uploads
MINIO_USE_SSL=false
MINIO_BUCKET=testpulse
UPLOAD_MAX_BYTES=2097152

MAIL_FROM=TestPulse <no-reply@testpulse.local>
SMTP_PORT=587
SMTP_SECURE=false

# AI test case drafts: none until a model server is ready; ollama needs OLLAMA_BASE_URL and
# OLLAMA_MODEL (in .env.dev / .env.prod)
AI_PROVIDER=none
AI_TIMEOUT_SEC=120

LOG_RETENTION_DAYS=14
INITIAL_ADMIN_NAME=ผู้ดูแลระบบ
