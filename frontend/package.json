{
  "name": "testpulse-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "predev": "npm run icons",
    "dev": "vite",
    "prebuild": "npm run icons",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "node scripts/gen-icons.mjs --check && npm run type-check && npm run lint && npm run format:check && npm run test",
    "preview": "vite preview",
    "test:e2e:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "canvas-confetti": "^1.9.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vuetify": "3.5.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@tabler/icons": "^3.48.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "sass": "~1.77.8",
    "typescript": "~5.6",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.21",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.12"
  }
}
