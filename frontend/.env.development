# npm run dev: the real backend (backend/: npm run dev on :4000, proxied as /api). Modules the
# backend doesn't have yet stay on the mock by themselves. Back to the mock for everything with
# VITE_API_MODE=mock npm run dev (or a .env.development.local).
VITE_API_MODE=real
# keep chosen modules on the mock, comma-separated (e.g. project,team)
VITE_API_MOCK=
