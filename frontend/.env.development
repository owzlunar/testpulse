# npm run dev: the backend (backend/: npm run dev on :4000, proxied as /api).
# Only the modules listed are on; the others (documents, reports, AI drafts …)
# are hidden until the backend has them.
# npm run dev:mock runs everything on the mock instead.
VITE_API_MODE=rest
VITE_API_REST=auth,user,role,team,project,settings,file,notification,audit,test-case,requirement,template,run,defect
