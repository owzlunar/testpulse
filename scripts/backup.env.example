# Settings for scripts/backup.sh and scripts/restore.sh. Copy to `backup.env` in the deploy folder
# (next to docker-compose.server.yml), fill it in, chmod 600. Never commit it: it holds passwords.
#
# The tools (mongodump, mongorestore, mc) run in containers, so the server needs only Docker.
# They reach MongoDB / MinIO either through the compose network (BACKUP_DOCKER_NETWORK, by service
# name, nothing published on the host) or through this machine, which is `host.docker.internal` to them.

# --- The docker network MongoDB and MinIO are on (`docker network ls`), e.g. testpulse. Set: the hosts
# below are service names (mongodb:27017, minio:9000). Empty: they are host.docker.internal:<published port>.
BACKUP_DOCKER_NETWORK=

# --- MongoDB: the database backup.sh dumps (the same one as MONGODB_URI in backend/.env.prod)
MONGODB_URI=mongodb://user:password@host.docker.internal:27017/testpulse?authSource=admin&replicaSet=rs0&directConnection=true
# restore.sh only: another login for the database it restores into (e.g. a test database's own user).
# Empty = MONGODB_URI's login.
RESTORE_MONGODB_URI=

# --- Where backups go: a MinIO / S3 on this side (usually the one the app stores files in)
# http(s)://host:port of the S3 API (not the web console)
BACKUP_S3_URL=http://host.docker.internal:9000
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# made by `backup.sh init` with object lock: nobody can delete a backup before it expires
BACKUP_BUCKET=testpulse-backups

# --- The off-site copy: another MinIO / S3, on another machine. Empty URL = no off-site copy.
OFFSITE_S3_URL=
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=

# --- Uploaded files: the same STORAGE_DRIVER as backend/.env.prod
#   local: backup.sh packs UPLOADS_DIR into the backup bucket
#   minio: the files already live in UPLOADS_BUCKET (on BACKUP_S3_URL); init turns on versioning and
#          backup.sh mirrors the bucket off-site
STORAGE_DRIVER=local
UPLOADS_DIR=./docker-data/uploads
UPLOADS_BUCKET=testpulse

# --- Days a backup (and an old version of an uploaded file) is kept, then deleted by MinIO itself
BACKUP_RETENTION_DAYS=14

# --- Scratch folder for a dump before it is uploaded (emptied after every run)
BACKUP_WORK_DIR=./docker-data/backup-work

# --- Tool images: pin them so a pull never changes the tools under you
MONGO_TOOLS_IMAGE=mongo:8
# docker (default): the tools above run in containers. local: they are installed here (the backup agent)
BACKUP_TOOLS=docker
MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
